# Settings for deploy/docker-compose.yml. Copy this file to deploy/.env and fill in the values.
# deploy/.env holds secrets: it is ignored by git and must never be committed.

# Password of the PostgreSQL user "veyra". Use letters and digits only, because it is placed inside a
# connection string. Generate one with: openssl rand -hex 32
POSTGRES_PASSWORD=

# Public host name of this installation, for example veyra.example.com. Needed only with
# deploy/docker-compose.caddy.yml. A DNS record for it must point at this server before Caddy starts.
VEYRA_DOMAIN=

# Port on 127.0.0.1 where Veyra answers on this machine without the reverse proxy. Change it if 8080 is taken.
VEYRA_HTTP_PORT=8080

# Ports on 127.0.0.1 where senders on this machine reach OTLP without TLS. Change them if they are taken.
VEYRA_OTLP_GRPC_PORT=4317
VEYRA_OTLP_HTTP_PORT=4318

# How many days of logs to keep. Older days are dropped every hour.
VEYRA_LOG_RETENTION_DAYS=14

# Disk guard: the most space log storage may use, in gigabytes. When it is exceeded, the oldest days are dropped
# first; today is always kept. Leave empty for no budget. Set it below the free space of the database disk.
VEYRA_MAX_LOG_STORAGE_GB=

# How many days of metric points to keep. Older days are dropped every hour.
VEYRA_METRIC_RETENTION_DAYS=30

# The most metric series Veyra accepts. Points of new series beyond it are dropped and logged; known series keep
# arriving. Raise it only when the database has room, and look for an attribute with too many values first.
VEYRA_MAX_METRIC_SERIES=50000

# How many days sign-in attempts and ended sessions are kept. They hold IP addresses and browser descriptions, which
# are personal data; only Admins and the person see them.
VEYRA_SIGN_IN_HISTORY_DAYS=90

# Only for the last Admin who lost both phone and recovery codes: their email here, restart, sign in with the password
# alone, set up a new second factor, then empty this again and restart.
VEYRA_REMOVE_SECOND_FACTOR=

# Veyra's public address, for example https://veyra.example.com. Alert notifications link to the alert with it.
# Leave empty and messages carry no link.
VEYRA_PUBLIC_URL=

# SMTP server for email notification channels. Leave VEYRA_SMTP_HOST empty to send no email; webhook channels work
# without it. VEYRA_SMTP_SECURITY is Auto (TLS on port 465, otherwise STARTTLS when offered), StartTls,
# SslOnConnect, or None (only for a relay on this machine). VEYRA_SMTP_PASSWORD is a secret.
VEYRA_SMTP_HOST=
VEYRA_SMTP_PORT=587
VEYRA_SMTP_SECURITY=Auto
VEYRA_SMTP_USERNAME=
VEYRA_SMTP_PASSWORD=
VEYRA_SMTP_FROM=
