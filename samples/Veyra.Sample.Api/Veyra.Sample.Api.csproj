<Project Sdk="Microsoft.NET.Sdk.Web">

  <!-- A plain ASP.NET Core app instrumented only with the standard OpenTelemetry .NET SDK. It shows that Veyra needs
       no Veyra-specific code in monitored applications. -->
  <PropertyGroup>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="OpenTelemetry.Exporter.OpenTelemetryProtocol" />
    <PackageReference Include="OpenTelemetry.Extensions.Hosting" />
  </ItemGroup>

</Project>
