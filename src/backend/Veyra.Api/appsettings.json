{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Veyra": {
    "Ingestion": {
      "MaxQueueLength": 10000
    },
    "Storage": {
      "ConnectionString": ""
    },
    "Query": {
      "MaxPageSize": 1000
    },
    "Alerting": {
      "EvaluationInterval": "00:00:30",
      "ErrorRate": {
        "Enabled": true,
        "Window": "00:05:00",
        "MinimumRecords": 20,
        "CautionRatio": 0.01,
        "WarningRatio": 0.05
      },
      "Notifications": {
        "DispatchInterval": "00:00:05",
        "BatchSize": 10,
        "SendTimeout": "00:00:10"
      }
    }
  }
}
