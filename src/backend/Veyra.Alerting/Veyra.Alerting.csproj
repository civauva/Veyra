<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <!-- The alert and notification REST endpoints are MVC controllers, webhooks go out through IHttpClientFactory,
         and webhook URLs are encrypted with Data Protection. All of it is part of the shared framework. -->
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Veyra.Core\Veyra.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="MailKit" />
    <PackageReference Include="Npgsql" />
  </ItemGroup>

  <ItemGroup>
    <!-- Forward-only schema scripts for the alerting schema, applied by the Storage module at startup. -->
    <EmbeddedResource Include="Migrations\*.sql" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Veyra.Alerting.Tests" />
    <InternalsVisibleTo Include="Veyra.Api.Tests" />
  </ItemGroup>

</Project>
