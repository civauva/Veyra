<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <!-- The OTLP endpoints are ASP.NET Core endpoints and a gRPC service. -->
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../Veyra.Core/Veyra.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Grpc.AspNetCore" />
  </ItemGroup>

  <ItemGroup>
    <!-- The official OTLP definitions from github.com/open-telemetry/opentelemetry-proto, release v1.11.1, unchanged.
         Only the files the logs and metrics services need. Generated types are internal: they are wire formats, not
         Veyra API. -->
    <Protobuf Include="Otlp/Protos/**/*.proto" ProtoRoot="Otlp/Protos" Access="Internal" GrpcServices="Both" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Veyra.Ingestion.Tests" />
    <InternalsVisibleTo Include="Veyra.Api.Tests" />
  </ItemGroup>

</Project>
