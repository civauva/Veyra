<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <!-- The OpAMP endpoint and the REST controllers are ASP.NET Core endpoints; Data Protection encrypts passwords. -->
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Veyra.Core\Veyra.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Google.Protobuf" />
    <PackageReference Include="Grpc.Tools" PrivateAssets="all" />
    <PackageReference Include="Npgsql" />
    <PackageReference Include="YamlDotNet" />
  </ItemGroup>

  <ItemGroup>
    <!-- The official OpAMP definitions from github.com/open-telemetry/opamp-spec, protocol v1, unchanged. Generated
         types are internal: they are wire formats, not Veyra API. -->
    <Protobuf Include="OpAmp/Protos/**/*.proto" ProtoRoot="OpAmp/Protos" Access="Internal" GrpcServices="None" />
  </ItemGroup>

  <ItemGroup>
    <!-- Forward-only schema scripts for the agents schema, applied by the Storage module at startup. -->
    <EmbeddedResource Include="Migrations\*.sql" />
    <!-- The installers for agents in other networks, served with Veyra's address filled in (VEY-40). -->
    <EmbeddedResource Include="Install\install.ps1" LogicalName="Veyra.Agents.Install.install.ps1" />
    <EmbeddedResource Include="Install\install.sh" LogicalName="Veyra.Agents.Install.install.sh" />
    <!-- The tested Collector configuration each agent's configuration is built from: one file, one contract. -->
    <EmbeddedResource Include="..\..\..\integrations\sqlserver\collector.yaml" LogicalName="Veyra.Agents.Templates.sqlserver.yaml" />
    <!-- The template's previous version, which a server can be rolled back to, and the connection probe (ADR 0028).
         Renaming the previous file at the next version changes only this line. -->
    <EmbeddedResource Include="..\..\..\integrations\sqlserver\collector.0.1.0.yaml" LogicalName="Veyra.Agents.Templates.sqlserver.previous.yaml" />
    <EmbeddedResource Include="..\..\..\integrations\sqlserver\probe.yaml" LogicalName="Veyra.Agents.Templates.sqlserver-probe.yaml" />
    <EmbeddedResource Include="..\..\..\integrations\sqlserver\azure-sql-database.yaml" LogicalName="Veyra.Agents.Templates.azure-sql-database.yaml" />
    <EmbeddedResource Include="..\..\..\integrations\windows\collector.yaml" LogicalName="Veyra.Agents.Templates.windows.yaml" />
    <EmbeddedResource Include="..\..\..\integrations\windows\iis.yaml" LogicalName="Veyra.Agents.Templates.iis.yaml" />
    <EmbeddedResource Include="..\..\..\integrations\linux\collector.yaml" LogicalName="Veyra.Agents.Templates.linux.yaml" />
    <EmbeddedResource Include="..\..\..\integrations\docker\collector.yaml" LogicalName="Veyra.Agents.Templates.docker.yaml" />
    <EmbeddedResource Include="..\..\..\integrations\postgres\collector.yaml" LogicalName="Veyra.Agents.Templates.postgres.yaml" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Veyra.Agents.Tests" />
    <InternalsVisibleTo Include="Veyra.Api.Tests" />
  </ItemGroup>

</Project>
